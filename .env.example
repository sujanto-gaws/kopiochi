# ===========================================
# Kopiochi - Domain-Driven Design API
# ===========================================

# -------------------------------------------
# Server Configuration
# -------------------------------------------
APP_SERVER_HOST=0.0.0.0
APP_SERVER_PORT=8080

# -------------------------------------------
# Database Configuration (PostgreSQL)
# -------------------------------------------
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_USER=postgres
# Not a real password. Postgres will refuse this value outright — set your
# own dev DB password here (see README.md "First-Time Setup").
APP_DB_PASSWORD=CHANGEME_SET_YOUR_OWN_DB_PASSWORD
APP_DB_NAME=kopiochi
APP_DB_SSLMODE=disable
APP_DB_MAX_CONNS=10
APP_DB_MIN_CONNS=2

# -------------------------------------------
# Logging Configuration
# -------------------------------------------
APP_LOG_LEVEL=info
APP_LOG_FORMAT=json

# -------------------------------------------
# Plugin Configuration
# -------------------------------------------
# The legacy HS256 jwt-auth plugin (and its APP_JWT_SECRET/APP_JWT_EXPIRY/
# APP_JWT_ISSUER env vars) has been removed. All token issuance/verification
# now goes through the RS256 identity module (modules/identity/infrastructure/
# token) using the RSA keypair generated by `make keys` (see README.md
# "First-Time Setup") and the auth.* settings in config/default.yaml.

# Rate Limiting
APP_RATELIMIT_REQUESTS=100
APP_RATELIMIT_WINDOW=1m

# CORS
APP_CORS_ALLOWED_ORIGINS=https://example.com,https://app.example.com
APP_CORS_ALLOW_CREDENTIALS=true

# -------------------------------------------
# Database Migrations (Goose)
# -------------------------------------------
# Migrations are located in: migrations/
# Run migrations: make migrate-up
# Check status: make migrate-status
# Create new: make migrate-create NAME=your_migration_name
