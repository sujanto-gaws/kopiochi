# ===========================================
# Kopiochi - Domain-Driven Design API
# ===========================================

# -------------------------------------------
# Server Configuration
# -------------------------------------------
APP_SERVER_HOST=0.0.0.0
APP_SERVER_PORT=8080

# -------------------------------------------
# Database Configuration (PostgreSQL)
# -------------------------------------------
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_USER=postgres
# Not a real password. Postgres will refuse this value outright — set your
# own dev DB password here (see README.md "First-Time Setup").
APP_DB_PASSWORD=CHANGEME_SET_YOUR_OWN_DB_PASSWORD
APP_DB_NAME=kopiochi
APP_DB_SSLMODE=disable
APP_DB_MAX_CONNS=10
APP_DB_MIN_CONNS=2

# -------------------------------------------
# Logging Configuration
# -------------------------------------------
APP_LOG_LEVEL=info
APP_LOG_FORMAT=json

# -------------------------------------------
# Security Middleware (CORS, rate limiting)
# -------------------------------------------
# The plugin registry is gone: CORS and rate limiting are constructed
# directly from the typed security.* config in config/default.yaml (see
# internal/httpx/router.go). The variables below are the real Viper keys,
# uppercased with "." -> "_" and the APP_ prefix.
#
# The previous APP_RATELIMIT_* / APP_CORS_* variables listed here mapped to
# no Viper key at all and were silently ignored; they have been replaced.
#
# The legacy HS256 jwt-auth plugin (and its APP_JWT_SECRET/APP_JWT_EXPIRY/
# APP_JWT_ISSUER env vars) has been removed. All token issuance/verification
# now goes through the RS256 identity module (modules/identity/infrastructure/
# token) using the RSA keypair generated by `make keys` (see README.md
# "First-Time Setup") and the auth.* settings in config/default.yaml.

# CORS. Off by default; the allowlist is comma-separated.
APP_SECURITY_CORS_ENABLED=false
APP_SECURITY_CORS_ALLOWED_ORIGINS=https://example.com,https://app.example.com
APP_SECURITY_CORS_ALLOW_CREDENTIALS=false

# Rate limiting. rate is requests per minute, per resolved client IP.
APP_SECURITY_RATE_LIMIT_ENABLED=false
APP_SECURITY_RATE_LIMIT_RATE=100
APP_SECURITY_RATE_LIMIT_BURST=100
APP_SECURITY_RATE_LIMIT_TTL=10m
APP_SECURITY_RATE_LIMIT_MAX_KEYS=100000

# Prometheus metrics, on their own listener. Loopback by default: /metrics
# describes the service's internals, and Config.Validate refuses an addr equal
# to the API's own.
APP_METRICS_ENABLED=false
APP_METRICS_ADDR=127.0.0.1:9090
APP_METRICS_PATH=/metrics

# -------------------------------------------
# Database Migrations (Goose)
# -------------------------------------------
# Migrations are located in: migrations/
# Run migrations: make migrate-up
# Check status: make migrate-status
# Create new: make migrate-create NAME=your_migration_name

# Key rotation. Set to the retired public key during a rotation; leave empty
# otherwise. See config/default.yaml.
APP_AUTH_PREVIOUS_PUBLIC_KEY_PATH=

# -------------------------------------------
# Notification Module
# -------------------------------------------
# The module is on by default (config/default.yaml). Everything below is an
# override; the keys are the Viper keys, uppercased with "." -> "_".
APP_NOTIFICATION_ENABLED=true
APP_NOTIFICATION_DISPATCHER_POLL_INTERVAL=5s
APP_NOTIFICATION_DISPATCHER_BATCH_SIZE=50
APP_NOTIFICATION_DISPATCHER_WORKERS=2
APP_NOTIFICATION_DISPATCHER_MAX_ATTEMPTS=6
APP_NOTIFICATION_DISPATCHER_BACKOFF_BASE=30s
APP_NOTIFICATION_DISPATCHER_BACKOFF_CAP=1h
APP_NOTIFICATION_DISPATCHER_STALLED_AFTER=5m
APP_NOTIFICATION_DISPATCHER_DRAIN_TIMEOUT=30s

# SMTP. Enabling this requires all three of host, from and the password below;
# the module refuses to start otherwise, rather than dead-lettering every mail.
APP_NOTIFICATION_EMAIL_ENABLED=false
APP_NOTIFICATION_EMAIL_SMTP_HOST=
APP_NOTIFICATION_EMAIL_SMTP_PORT=587
APP_NOTIFICATION_EMAIL_FROM=
# SMTP AUTH identity. Empty authenticates as the from address.
APP_NOTIFICATION_EMAIL_USERNAME=
APP_NOTIFICATION_EMAIL_TIMEOUT=10s
# Env only, never in a YAML file. Not a real password.
APP_NOTIFICATION_EMAIL_PASSWORD=CHANGEME_SET_YOUR_OWN_SMTP_PASSWORD

# The development sender: writes rendered messages to the log and settles the
# row as sent. Never enable it in a deployment that is supposed to send mail.
APP_NOTIFICATION_LOG_SENDER_ENABLED=false
APP_NOTIFICATION_LOG_SENDER_CHANNEL=email
